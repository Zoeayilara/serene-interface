# Copy to .env for local development. On Netlify, set these under
# Site configuration → Environment variables (never commit real values).

# Your Supabase project: Project Settings → API (Data API URL) and API Keys.
SUPABASE_URL=https://your-project-id.supabase.co
# The secret key (sb_secret_…) or the legacy service_role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# At least 32 random characters. Signs everyone's login cookie.
SESSION_SECRET=

# Used ONCE: the first sign-in with these creates the Hardware Director account.
ADMIN_USERNAME=director
ADMIN_PASSWORD=
